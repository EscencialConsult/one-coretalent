# Copiá este archivo como .env y completá los valores reales (pedíselos a Facundo).
# Lista de variables tomada directo de app/core/config.py — esa es la fuente de verdad,
# no este archivo, así que si algo no coincide, confiá en config.py.

# ── Base de datos (Supabase Postgres) ──────────────────────────────────────────
# Rol app_runtime: sin privilegios, es el que usa la app en cada request.
DATABASE_URL=postgresql://app_runtime.xxxxx:contraseña@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Rol postgres: con privilegios DDL, SOLO para correr Alembic (CREATE POLICY, ALTER TABLE...).
# Si queda vacío, Alembic intenta usar DATABASE_URL y va a fallar contra el rol de runtime
# (no tiene permiso para migrar).
DATABASE_URL_MIGRATIONS=postgresql://postgres.xxxxx:contraseña@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Conexión a Supabase desde afuera requiere SSL. Dejar en true salvo que apuntes a un
# Postgres local propio sin SSL.
DB_SSL=true

# ── Seguridad ───────────────────────────────────────────────────────────────
# Clave para firmar los JWT de sesión. Generá una aleatoria de al menos 32 caracteres
# (ej. `openssl rand -hex 32`). En ENV=prod, la app rechaza arrancar si es corta o es
# alguno de los valores de ejemplo de este archivo.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-produccion

ACCESS_TOKEN_EXPIRE_MINUTES=480
ENV=prod

# Orígenes permitidos del frontend, separados por coma. Sin '*' en producción (la app
# lo rechaza al arrancar).
CORS_ORIGINS=https://coretalent.onelabs.pro

# ── Correo (API HTTP de Brevo, no SMTP) ────────────────────────────────────────
# Se manda por la API HTTP de Brevo (puerto 443): varios hostings tipo PaaS bloquean
# puertos SMTP salientes, pero HTTPS nunca. Si BREVO_API_KEY queda vacío, el envío de
# correos se deshabilita solo (no rompe nada, pero recuperar contraseña etc. no funciona).
BREVO_API_KEY=
SMTP_FROM=no-reply@escencial.com
SMTP_FROM_NAME=ONE Core-Talent

# ── IA (OpenAI) — informes gerenciales consolidados (opcional) ────────────────
# La IA solo redacta sobre resultados ya calculados, nunca calcula resultados.
# Vacío = deshabilitado, no rompe nada.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=3500

# ── URLs de la app (para los links de los correos) ─────────────────────────────
PUBLIC_BASE_URL=https://coretalent.onelabs.pro
# Dominio para subdominios por empresa (ej. one.com → https://empresa.one.com). Vacío
# hasta tener ese dominio activo.
TENANT_DOMAIN=

# ── Supabase Storage (CVs, selfies, firmas) ────────────────────────────────────
# service_role: SOLO server-side, nunca se expone al navegador (salta RLS de Storage).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
